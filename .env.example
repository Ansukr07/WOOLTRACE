# Live mandi price and arrival data (CEDA Agmarknet)
CEDA_API_TOKEN=your_ceda_api_token

# Grounded AI market recommendations (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Optional: configure a public app URL for payment callbacks
VITE_APP_URL=http://localhost:5174

# Direct UPI intent/QR configuration. The VITE values power the local frontend
# fallback; UPI_COLLECT_VPA is used by the optional serverless API.
VITE_UPI_ID=your-project-vpa@bank
VITE_UPI_NAME=KhetSetu Trade Payment
PAYMENT_GATEWAY_PROVIDER=DIRECT_UPI
UPI_COLLECT_VPA=khetsetu@upi

# Production gateway credentials belong only in the deployment environment.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
