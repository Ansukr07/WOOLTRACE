{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host 127.0.0.1 --port %PORT%",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/mandi-forecast.py": { "runtime": "python3.12" }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/core?handler=health" },
    { "source": "/api/crop50", "destination": "/api/core?handler=crop50" },
    { "source": "/api/khetsetu", "destination": "/api/core?handler=khetsetu" },
    { "source": "/api/learning-resources", "destination": "/api/core?handler=learning-resources" },
    { "source": "/api/login", "destination": "/api/core?handler=login" },
    { "source": "/api/register", "destination": "/api/core?handler=register" },
    { "source": "/api/market-records", "destination": "/api/core?handler=market-records" },
    { "source": "/api/payments", "destination": "/api/core?handler=payments" },
    { "source": "/api/seed-demo", "destination": "/api/core?handler=seed-demo" },
    { "source": "/api/bidding/:route*", "destination": "/api/bidding?route=:route*" },
    { "source": "/api/market/:route*",  "destination": "/api/market?route=:route*"  },
    { "source": "/api/processing/:route*", "destination": "/api/processing?route=:route*" },
    { "source": "/api/qa/:route*",      "destination": "/api/qa?route=:route*"      },
    { "source": "/api/ai/mandi-forecast", "destination": "/api/ai/mandi-forecast.py" },
    { "source": "/api/transport/:route*", "destination": "/api/transport?route=:route*" },
    { "source": "/api/warehouse/:route*", "destination": "/api/warehouse?route=:route*" },
    { "source": "/api/notifications/:route*", "destination": "/api/notifications?route=:route*" }
  ]
}
